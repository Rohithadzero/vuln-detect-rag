# VulnDetectRAG Configuration
# Copy this file to .env and update values as needed

# ==========================================
# LLM Configuration
# ==========================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Use local embeddings (no external API needed)
USE_LOCAL_EMBEDDINGS=true
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ==========================================
# Scanner paths (leave empty for auto-detection)
# Example: NMAP_PATH=C:\Program Files (x86)\Nmap\nmap.exe
# ==========================================
# NMAP_PATH=
# NUCLEI_PATH=
# BURP_PATH=   # Burp Suite (e.g., C:\tools\burp\burpsuite.jar)
# ZAP_PATH=    # OWASP ZAP (e.g., C:\tools\zap\zap.bat)

# ==========================================
# CORS Configuration
# Set comma-separated origins, or leave empty for defaults
# Example: CORS_ORIGINS=http://localhost:5173,https://example.com
# ==========================================
# CORS_ORIGINS=

# ==========================================
# Database (auto-configured - usually no need to change)
# ==========================================
# DATABASE_URL=sqlite:///./data/vulndetect.db
# CHROMA_PERSIST_DIR=./data/chroma

# ==========================================
# Application
# ==========================================
DEBUG=true

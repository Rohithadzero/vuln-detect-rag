# Copy to backend/.env and fill in. NEVER commit backend/.env — it is gitignored.

# ---------------------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------------------
# auto | groq | gemini | ollama | openai | huggingface
# "auto" picks the first provider in LLM_PROVIDER_ORDER that is configured,
# so the app works with a cloud key, a local model, or both.
LLM_PROVIDER=auto

# Preference order used when LLM_PROVIDER=auto.
# Cloud first (no model download, no GPU); Ollama as the offline fallback.
# Put ollama first if you need fully local, air-gapped operation.
LLM_PROVIDER_ORDER=groq,gemini,ollama

# Fall through to the next provider when one is rate-limited or offline.
LLM_FALLBACK=1

# --- Groq (free tier) — get a key at https://console.groq.com/keys ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Google Gemini (free tier) — get a key at https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# --- Ollama (local, offline) — https://ollama.com ---
OLLAMA_BASE_URL=http://localhost:11434
# Leave empty to auto-select the best installed local model.
# Cloud-tagged models (":cloud") are never auto-selected: they would send scan
# data off-machine and break the privacy-first guarantee.
OLLAMA_MODEL=
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Optional providers ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=

# ---------------------------------------------------------------------------
# Generation tuning
# ---------------------------------------------------------------------------
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2000
# Prompts carry several retrieved documents; the 2048-token default of some
# backends silently truncates that context away.
LLM_CONTEXT_WINDOW=8192
LLM_TIMEOUT=180
# Set to 1 to let reasoning models emit chain-of-thought (slower, and they can
# exhaust the token budget before producing an answer).
LLM_THINKING=0

# ---------------------------------------------------------------------------
# Embeddings — local by default, so the corpus never leaves the machine
# ---------------------------------------------------------------------------
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
USE_LOCAL_EMBEDDINGS=True

# ---------------------------------------------------------------------------
# Vector store — the writer and reader MUST agree on this collection name
# ---------------------------------------------------------------------------
CHROMA_COLLECTION=cve_knowledge

# ---------------------------------------------------------------------------
# Retrieval tuning
# ---------------------------------------------------------------------------
# Minimum cosine similarity for a document to count as context. Below this the
# assistant reports that it has no answer instead of guessing.
RAG_SCORE_THRESHOLD=0.25
# How many documents to fetch before diversity filtering trims to top_k.
RAG_OVERFETCH=4
RAG_CONTEXT_BUDGET=6000
RAG_HISTORY_BUDGET=2000

# ---------------------------------------------------------------------------
# Scanner paths (leave empty for auto-detection)
# ---------------------------------------------------------------------------
# NMAP_PATH=
# NUCLEI_PATH=
# BURP_PATH=
# ZAP_PATH=

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEBUG=False

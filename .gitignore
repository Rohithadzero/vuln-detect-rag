# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
venv/
env/
.venv/

# Environment
.env
*.env
!.env.example

# Database
*.db
*.sqlite3

# ChromaDB persistence — binary index data is rebuildable from
# scripts/seed_cve_data.py and must never be committed.
data/chroma/
backend/data/chroma/
scripts/data/chroma/
**/chroma/
*.bin

# Committed virtualenv (must never be tracked)
backend/venv/

# Logs
*.log

# Node
node_modules/
frontend/dist/

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Stray Windows artifact created by a shell redirect to NUL.
# Ignored rather than deleted, pending confirmation.
nul

# Quarantined non-canonical variants (see archive/README.md).
# The README itself is tracked; the duplicate trees are not, to keep them
# out of the repo while remaining on disk for reference.
archive/EMET/
archive/v1.5/

# Documents. The root README is the only prose file this repo publishes;
# every other Markdown file and every PDF stays local. Research manuscripts,
# their sources and their build artifacts are kept out of the repository
# entirely -- they are written and reviewed elsewhere.
*.pdf
*.md
!/README.md
paper/
research_paper.md

# Archives and notebooks kept beside the project but not published.
*.zip
*.ipynb
*.xlsx

# Resumable evaluation checkpoints. Transient per-run state, rewritten every
# few questions while an evaluation is in flight; the finished results file
# is what carries the measurements.
backend/data/eval_*_checkpoint.json

# Local .env backups taken before pinning provider models.
.env.bak.*
